{
  "name": "streamio",
  "productName": "Streamio",
  "version": "1.11.0",
  "description": "A media center for the forest \u2014 movies & series from community addons.",
  "main": "main.js",
  "author": "aidan Genoud <aidan.genoud@jobtrek.ch>",
  "homepage": "https://github.com/kodix75/streamio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux appimage deb",
    "dist:appimage": "electron-builder --linux appimage"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "streamio.forest",
    "productName": "Streamio",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js"
    ],
    "extraFiles": [
      {
        "from": "../app",
        "to": "app"
      },
      {
        "from": "../server",
        "to": "server"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo;Video",
      "icon": "../app/assets/logo.png",
      "mimeTypes": [
        "x-scheme-handler/streamio"
      ]
    },
    "appImage": {
      "artifactName": "Streamio-${version}.AppImage"
    }
  }
}